{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "nodeSelector",
    "affinity",
    "tolerations",
    "topologySpreadConstraints",
    "healthProbe",
    "logLevel"
  ],
  "properties": {
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "properties": {
        "kubernetes.io/os": {
          "type": "string",
          "enum": ["linux"]
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "affinity": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "healthProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "logLevel": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"]
    }
  }
}
