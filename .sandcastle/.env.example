# 可选；默认读取宿主机通过 `codex login` 生成的 ~/.codex/auth.json。
# 只有凭据文件位于其他位置时才设置。
CODEX_AUTH_FILE=

# 可选；留空时调度器从当前 `gh auth` 会话读取。
GH_TOKEN=

# 可选运行参数。
SANDCASTLE_MODEL=gpt-5.6-sol
SANDCASTLE_MAX_PARALLEL=3
SANDCASTLE_MAX_ITERATIONS=3
# 单个 PR 的 CI 失败自动修复次数；设为 0 可关闭自动修复。
SANDCASTLE_MAX_CI_REPAIR_ATTEMPTS=2
# agent 连续无 stdout 的容忍时间；high reasoning 与大段 tool output 期间可能长时间静默。
SANDCASTLE_IDLE_TIMEOUT_SECONDS=1800
SANDCASTLE_CI_TIMEOUT_MINUTES=60
SANDCASTLE_CI_POLL_SECONDS=15
